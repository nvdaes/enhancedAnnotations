#. Translators: the description for the reportDetailsSummary script.
#: addon\globalPlugins\enhancedAnnotations\__init__.py:35
msgid "Go to annotation details under the system caret."
msgstr "Перейти к подробным сведениям об аннотации под системным курсором."

#. Translators: the description for the script_popAnnotationStack script.
#: addon\globalPlugins\enhancedAnnotations\__init__.py:86
msgid "Return to annotation subject"
msgstr "Вернуться к теме аннотации"

#. Translators: message given when there is no annotation details for the reportDetailsSummary script.
#: addon\globalPlugins\enhancedAnnotations\__init__.py:97
msgid "No annotation subject present"
msgstr "Отсутствует тема аннотации"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "Enhanced Annotations"
msgstr "Расширенные аннотации"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Adds ability to move the cursor to additional details, and back to the original element, in browse mode.\n"
"This has been requested at\n"
"https://github.com/nvaccess/nvda/issues/13940\n"
msgstr "Добавляет возможность перемещать курсор к дополнительным деталям и обратно к исходному элементу в режиме обзора.\n"
"Это было запрошено по адресу\n"
"https://github.com/nvaccess/nvda/issues/13940\n"

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:28
msgid "* Updates to translations."
